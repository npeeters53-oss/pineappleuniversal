local function updateHighlight(other)
	if not highlightsEnabled or other == player or not other.Character then
		return
	end

	if other.Character:FindFirstChild("UniversalPlayerHighlight") then
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "UniversalPlayerHighlight"
	highlight.FillColor = COLORS.Green
	highlight.OutlineColor = COLORS.Gold
	highlight.FillTransparency = 0.65
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = other.Character
end

local function setHighlights(enabled)
	highlightsEnabled = enabled

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and other.Character then
			local existing = other.Character:FindFirstChild("UniversalPlayerHighlight")

			if enabled and not existing then
				updateHighlight(other)
			elseif not enabled and existing then
				existing:Destroy()
			end
		end
	end

	highlightButton.Text = enabled and "Highlights: ON" or "Highlights: OFF"
	highlightButton.BackgroundColor3 = enabled and COLORS.Green or COLORS.PanelLight
	highlightButton.TextColor3 = enabled and COLORS.Background or COLORS.White
end

