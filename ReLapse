local function setSmoothnessFromX(x)
	local width = math.max(1, sliderTrack.AbsoluteSize.X)
	smoothness = math.clamp(
		(x - sliderTrack.AbsolutePosition.X) / width,
		0.05,
		1
	)

	sliderFill.Size = UDim2.new(smoothness, 0, 1, 0)
	sliderDot.Position = UDim2.new(smoothness, 0, 0.5, 0)

	local percent = math.floor(smoothness * 100 + 0.5)
	local speedText = percent >= 70 and "Very Fast"
		or (percent >= 35 and "Fast" or "Smooth")

	smoothValue.Text = speedText .. " • " .. percent .. "%"
end

