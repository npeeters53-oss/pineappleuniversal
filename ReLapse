local function nearestLivingPlayer()
	local char = player.Character
	local myRoot = char and char:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	local nearest
	local nearestDistance = math.huge

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local targetChar = other.Character
			local hum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
			local root = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

			if hum and hum.Health > 0 and root then
				local distance = (root.Position - myRoot.Position).Magnitude
				if distance < nearestDistance then
					nearestDistance = distance
					nearest = other
				end
			end
		end
	end

	return nearest
end

-- Camera update
RunService:BindToRenderStep(
	"UniversalCameraUpdate",
	Enum.RenderPriority.Camera.Value + 1,
	function(deltaTime)
		camera = workspace.CurrentCamera
		if not camera then return end

		if spectating then
			if not spectateTarget or not spectateTarget.Parent then
				stopSpectating()
				return
			end

			local char = spectateTarget.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			if hum and hum.Health > 0 then
				camera.CameraType = Enum.CameraType.Custom
				camera.CameraSubject = hum
				targetLabel.Text = "Target: " .. spectateTarget.DisplayName
			else
				targetLabel.Text = "Target: Respawning..."
			end
			return
		end

		if lockEnabled then
			local target = nearestLivingPlayer()
			local char = target and target.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")

			if root then
				local desired = CFrame.lookAt(camera.CFrame.Position, root.Position)
				local alpha = 1 - math.exp(-smoothness * 18 * deltaTime)
				camera.CFrame = camera.CFrame:Lerp(desired, alpha)
				targetLabel.Text = "Target: " .. target.DisplayName
			else
				targetLabel.Text = "Target: No players found"
			end
		else
			targetLabel.Text = "Target: None"
		end
	end
)

