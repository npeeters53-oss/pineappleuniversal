local function isLockInput(input)
	local matchesKey = lockKey ~= nil
		and input.UserInputType == Enum.UserInputType.Keyboard
		and input.KeyCode == lockKey

	local matchesMouse = lockMouseButton ~= nil
		and input.UserInputType == lockMouseButton

	return matchesKey or matchesMouse
end

-- Keybind capture and Hold / Toggle input
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if waitingForBinding then
		local inputType = input.UserInputType
		local isMouse = inputType == Enum.UserInputType.MouseButton1
			or inputType == Enum.UserInputType.MouseButton2
			or inputType == Enum.UserInputType.MouseButton3

		if inputType == Enum.UserInputType.Keyboard then
			if input.KeyCode == Enum.KeyCode.Escape then
				waitingForBinding = false
				bindingButton.Text = "Change Key"
				return
			end

			lockKey = input.KeyCode
			lockMouseButton = nil
			waitingForBinding = false
			bindingButton.Text = "Change Key"
			bindingStatus.Text = "Current: " .. bindingName()
			return
		elseif isMouse then
			lockMouseButton = inputType
			lockKey = nil
			waitingForBinding = false
			bindingButton.Text = "Change Key"
			bindingStatus.Text = "Current: " .. bindingName()
			return
		end

		return
	end

	if gameProcessed or UserInputService:GetFocusedTextBox() then
		return
	end

	if not isLockInput(input) then
		return
	end

	if activationMode == "Toggle" then
		setLock(not lockEnabled)
	else
		holdInputActive = true
		setLock(true)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if activationMode == "Hold" and isLockInput(input) then
		holdInputActive = false
		setLock(false)
	end
end)

UserInputService.WindowFocusReleased:Connect(function()
	if activationMode == "Hold" then
		holdInputActive = false
		setLock(false)
	end
end)

