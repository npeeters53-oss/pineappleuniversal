local function getLivingPlayers()
	local result = {}

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local char = other.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			if hum and hum.Health > 0 then
				table.insert(result, other)
			end
		end
	end

	table.sort(result, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	return result
end

local function restoreCamera()
	camera = workspace.CurrentCamera
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if camera and hum then
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = hum
	end
end

local function setLock(enabled)
	lockEnabled = enabled

	if enabled then
		spectating = false
		spectateTarget = nil
		holdInputActive = activationMode == "Hold"
		restoreCamera()
	else
		holdInputActive = false
	end

	if lockButton then
		lockButton.Text = enabled and "Lock-on: ON" or "Lock-on: OFF"
		lockButton.BackgroundColor3 = enabled and COLORS.Green or COLORS.PanelLight
		lockButton.TextColor3 = enabled and COLORS.Background or COLORS.White
	end
end

local function stopSpectating()
	spectating = false
	spectateTarget = nil
	spectateIndex = 0
	restoreCamera()
end

local function nextSpectateTarget()
	local targets = getLivingPlayers()

	if #targets == 0 then
		stopSpectating()
		return
	end

	spectateIndex = (spectateIndex % #targets) + 1
	spectateTarget = targets[spectateIndex]
	spectating = true
	lockEnabled = false
	holdInputActive = false

	camera = workspace.CurrentCamera
	local char = spectateTarget.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if camera and hum then
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = hum
	end

	if lockButton then
		lockButton.Text = "Lock-on: OFF"
		lockButton.BackgroundColor3 = COLORS.PanelLight
		lockButton.TextColor3 = COLORS.White
	end
end

